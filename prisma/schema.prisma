// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
  coupons   Coupon[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Raffle {
  id          String   @id @default(cuid())
  title       String
  watchBrand  String?
  watchModel  String?
  watchName   String
  watchDetails String?
  zodiacSign  String
  drawDate    DateTime
  price1      Int      // Price for 1 ticket in MXN
  price2      Int      // Price for 2+ tickets in MXN
  promoEnabled Boolean @default(true)
  promoMinTickets Int  @default(2)
  isActive    Boolean  @default(true)
  winningNumber Int?
  imageUrl    String?  // Uploaded watch photo URL
  galleryImages String[] @default([]) // Optional extra watch photos
  lotteryUrl  String?  // Official lottery result URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]
}

model Ticket {
  id          String   @id @default(cuid())
  number      Int      // 0 to 99
  status      String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  
  // Relations
  raffleId    String
  raffle      Raffle   @relation(fields: [raffleId], references: [id])
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  // Manual buyer info (when admin assigns without user account)
  buyerName   String?
  buyerPhone  String?
  notes       String?
  pricePaid   Int?    // Actual price charged for this ticket (MXN)
  couponCode  String?
  discountPercent Int?
  stripeSessionId String?
  reservedAt  DateTime?
  
  // Admin who assigned this manually (if applicable)
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([raffleId, number])
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  discountPercent Int
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdByAdminId String?
  createdByAdmin Admin? @relation(fields: [createdByAdminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
